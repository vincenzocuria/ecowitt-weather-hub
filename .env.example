# Configurazione Host e Porta
HOST=0.0.0.0
PORT=8080
HOST_PORT=8090
TZ=Europe/Rome
TIMEZONE=Europe/Rome
DATA_DIR=/data

# Coordinate Stazione e Altitudine (Lat/Lon/Elevazione s.l.m.)
LOCATION_NAME=Corigliano-Rossano
LATITUDE=39.623928
LONGITUDE=16.504933
ELEVATION=68.0

# Sicurezza & Accesso Riservato (Persistent Device Token)
AUTH_TOKEN=os2kpY1eb6nbUifjuPmVD6qzP9H6nuM7Znfx8IVhFU0

# Canale Notifiche Push ntfy.sh
NTFY_TOPIC=ecowitt_weather_alerts_curia

# Token Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=

# Soglie Allarmi Meteo
SOIL_MOISTURE_LOW_THRESHOLD=25.0
LIGHTNING_MAX_DISTANCE_KM=30.0
TEMP_FREEZE_THRESHOLD_C=1.0
TEMP_HEAT_THRESHOLD_C=38.0
RAIN_RATE_ALERT_MM_HR=5.0

# Configurazione Aton Green Storage & Fotovoltaico
ATON_ENABLED=true
ATON_USERNAME=
ATON_PASSWORD=
ATON_SN=
ATON_POLL_INTERVAL_SEC=20

# Soglie Allarmi Energetici
ENERGY_HIGH_CONSUMPTION_W=3500.0
ENERGY_REPORT_HOUR=21
ENERGY_REPORT_ENABLED=true

# Configurazione Climatizzazione Smart LG ThinQ Connect
LG_THINQ_ENABLED=true
LG_THINQ_PAT=
LG_THINQ_COUNTRY=IT
LG_THINQ_POLL_INTERVAL_SEC=30
CLIMATE_SOLAR_ECO_ENABLED=true
CLIMATE_SOLAR_SURPLUS_THRESHOLD_W=1500.0
CLIMATE_BATTERY_MIN_SOC=60.0

# Configurazione Samsung SmartThings
SMARTTHINGS_ENABLED=true
SMARTTHINGS_PAT=
