# =================================================================
# Configurazione Ambiente per Ecowitt Weather Hub
# Copia questo file in '.env' e personalizza i parametri.
# =================================================================

# Server
HOST=0.0.0.0
PORT=8080
HOST_PORT=8090
TZ=Europe/Rome
TIMEZONE=Europe/Rome
DATA_DIR=/data

# Coordinate Geografiche Stazione (Lat/Lon in gradi decimali)
LATITUDE=41.9028
LONGITUDE=12.4964

# Notifiche Push Istantanee via ntfy (App gratuita Android / iOS)
# Scegli un nome univoco per il tuo canale ntfy
NTFY_TOPIC=mio_canale_meteo_segreto

# Cloudflare Tunnel Token (Opzionale: per esporre la dashboard online senza aprire porte)
CLOUDFLARE_TUNNEL_TOKEN=

# Soglie Allarmi Meteo Standard
SOIL_MOISTURE_LOW_THRESHOLD=25.0
LIGHTNING_MAX_DISTANCE_KM=30.0
TEMP_FREEZE_THRESHOLD_C=1.0
TEMP_HEAT_THRESHOLD_C=38.0
RAIN_RATE_ALERT_MM_HR=5.0

# Soglie Allarmi Eventi Anomali
PRESSURE_DROP_3H_THRESHOLD=2.0
TEMP_DROP_1H_THRESHOLD=4.0
TEMP_RISE_1H_THRESHOLD=4.0
GUST_SPIKE_THRESHOLD_KMH=45.0
RAIN_BURST_THRESHOLD_MM_HR=25.0
UV_EXTREME_THRESHOLD=8
 
# =================================================================
# Configurazione Accumulatore & Inverter Aton Green Storage
# =================================================================
ATON_ENABLED=true
ATON_USERNAME=Curia
ATON_PASSWORD=calabro
ATON_SN=R21MY00735F
ATON_POLL_INTERVAL_SEC=20

# Soglie Allarmi Energetici
ENERGY_HIGH_CONSUMPTION_W=3500.0
ENERGY_BATTERY_LOW_PCT=15.0
ENERGY_BATTERY_FULL_PCT=98.0
ENERGY_REPORT_HOUR=21
ENERGY_REPORT_ENABLED=true

